---
import Layout from "../layouts/Layout.astro";
import Icon from "./Icon.astro";
type Props = { title: string; activePath: string };
const { title, activePath } = Astro.props;
const navItems = [
  { href: "/dashboard", label: "Ringkasan", icon: "grid", description: "Semua yang perlu kamu tahu tentang servermu." },
  { href: "/dashboard/server", label: "Konsol server", icon: "terminal", description: "Kendalikan server dan ikuti aktivitasnya secara langsung." },
  { href: "/dashboard/worlds", label: "World", icon: "world", description: "Tempat petualangan dimulai. Kelola dan cadangkan duniamu." },
  { href: "/dashboard/addons", label: "Addon", icon: "pack", description: "Beri duniamu lebih banyak kemungkinan." },
  { href: "/dashboard/players", label: "Pemain", icon: "players", description: "Kenali teman-teman yang menghidupkan servermu." },
  { href: "/dashboard/settings", label: "Pengaturan", icon: "settings", description: "Sesuaikan cara bermain dan konfigurasi server." },
];
const current = navItems.find((item) => item.href === activePath);
---

<Layout title={title}>
  <div class="app-shell">
    <a class="skip-link" href="#main-content">Langsung ke konten</a>
    <aside class="sidebar">
      <a href="/dashboard" class="brand"><span class="brand-mark"><Icon name="pack" size={27} /></span><span>Bedrock<span class="brand-sub">Server dashboard</span></span></a>
      <div class="workspace">
        <span class="workspace-icon"><Icon name="server" /></span><div>Server pribadi<small>Minecraft Bedrock Edition</small></div><span class="workspace-dot"></span>
      </div>
      <nav aria-label="Navigasi utama">
        <p class="nav-label">Kelola server</p><ul>
          {
            navItems.map((item) => (
              <li>
                <a href={item.href} class:list={["nav-link", { active: activePath === item.href }]} aria-current={activePath === item.href ? "page" : undefined}>
                  <Icon name={item.icon} />
                  <span>{item.label}</span>
                  {activePath === item.href && <span class="nav-active-dot" />}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-tip">
          <span class="tip-icon"><Icon name="world" /></span><strong>Dunia baru, cerita baru.</strong><p>Siapkan world sesuai gaya bermainmu.</p><a href="/dashboard/setup"
            >Siapkan world <Icon name="plus" size={16} /></a
          >
        </div><button id="global-logout-btn" class="logout"><Icon name="logout" size={18} />Keluar dari dashboard</button><span class="sidebar-footer"
          >Dibuat untuk petualanganmu.</span
        >
      </div>
    </aside>
    <div class="workspace-main">
      <header class="topbar">
        <div class="breadcrumb">Server pribadi <Icon name="chevron" size={14} /><span>{current?.label ?? "Penyiapan world"}</span></div><div class="topbar-right">
          <span class="edition-tag">Bedrock Edition</span><span class="avatar" title="Administrator">A</span>
        </div>
      </header>
      <main id="main-content" class="page-content">
        <div class="page-heading">
          <div><h1>{current?.label ?? "Siapkan world baru"}</h1><p>{current?.description ?? "Tentukan duniamu, lalu mulai bermain bersama."}</p></div><span
            id="global-server-badge"
            class="status-badge"
            role="status">Memeriksa server…</span
          >
        </div>
        <slot />
        <footer class="page-footer"><span><span class="footer-dot"></span> Minecraft Bedrock Server</span><span>Petualangan besar dimulai dari satu blok.</span></footer>
      </main>
    </div>
  </div>
  <script>
    const badge = document.getElementById("global-server-badge");
    async function refreshServerStatus() {
      try {
        const response = await fetch("/api/server/status");
        if (!response.ok) throw new Error();
        const data = await response.json();
        if (badge) {
          badge.textContent = data.status.running ? "Server online" : "Server offline";
          badge.className = `status-badge ${data.status.running ? "online" : "offline"}`;
        }
      } catch {
        if (badge) {
          badge.textContent = "Status tidak tersedia";
          badge.className = "status-badge offline";
        }
      }
    }
    document.getElementById("global-logout-btn")?.addEventListener("click", async () => {
      try {
        const response = await fetch("/api/auth/logout", { method: "POST" });
        if (!response.ok) throw new Error();
        window.location.href = "/login";
      } catch {
        if (badge) badge.textContent = "Gagal keluar. Coba lagi.";
      }
    });
    refreshServerStatus();
    setInterval(refreshServerStatus, 5000);
  </script>
</Layout>

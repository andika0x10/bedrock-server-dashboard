---
import DashboardShell from "../../components/DashboardShell.astro";
---

<DashboardShell title="Kelola Addon | Bedrock Dashboard" activePath="/dashboard/addons">
  <div class="notice">
    Addon diterapkan pada world: <strong id="pack-world">memuat…</strong>. Hentikan server sebelum mengimpor, mengaktifkan, menonaktifkan, atau menghapus addon. Nyalakan kembali
    untuk menerapkan perubahan.
  </div>
  <section class="space-y-6">
    <div id="feedback" role="status" aria-live="polite" class="hidden rounded-xl border border-[#E5E6EF] bg-[#FFFFFF] px-4 py-3 text-sm"></div>

    <article class="rounded-2xl border border-[#E5E6EF] bg-[#FFFFFF] p-5 sm:p-6">
      <h2 class="text-lg font-semibold text-[#242638]">Impor addon</h2>
      <p class="mt-1 text-sm text-[#747788]">Format yang didukung: .mcpack, .mcaddon</p>

      <form id="pack-upload-form" class="mt-4 flex flex-col gap-3 sm:flex-row sm:items-center">
        <label class="sr-only" for="pack-file">Pilih file addon</label>
        <input
          id="pack-file"
          type="file"
          accept=".mcpack,.mcaddon"
          class="w-full min-w-0 flex-1 rounded-xl border border-[#E5E6EF] bg-[#FBFBFD] px-3 py-3 text-sm text-[#747788] file:mr-3 file:rounded-lg file:border-0 file:bg-[#E5E6EF] file:px-3 file:py-2 file:text-xs file:font-semibold file:text-[#45445A]"
        />
        <button type="submit" class="h-12 shrink-0 whitespace-nowrap rounded-xl bg-[#7154C7] px-5 text-sm font-semibold text-white transition hover:bg-[#6043B5] sm:min-w-[9.5rem]"
          >Impor addon</button
        >
      </form>
    </article>

    <article class="rounded-2xl border border-[#E5E6EF] bg-[#FFFFFF] p-5 sm:p-6">
      <h3 class="text-sm font-semibold text-[#45445A]">Resource Pack</h3>
      <div class="mt-3 overflow-x-auto rounded-xl border border-[#E5E6EF]">
        <table class="min-w-full divide-y divide-[#E5E6EF] text-left text-sm">
          <thead class="bg-[#F7F8FB] text-[#747788]">
            <tr>
              <th class="px-4 py-3">Nama</th>
              <th class="px-4 py-3">Versi</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Aksi</th>
            </tr>
          </thead>
          <tbody id="resource-pack-table" class="divide-y divide-[#E5E6EF] bg-[#FBFBFD]"></tbody>
        </table>
      </div>
    </article>

    <article class="rounded-2xl border border-[#E5E6EF] bg-[#FFFFFF] p-5 sm:p-6">
      <h3 class="text-sm font-semibold text-[#45445A]">Behavior Pack</h3>
      <div class="mt-3 overflow-x-auto rounded-xl border border-[#E5E6EF]">
        <table class="min-w-full divide-y divide-[#E5E6EF] text-left text-sm">
          <thead class="bg-[#F7F8FB] text-[#747788]">
            <tr>
              <th class="px-4 py-3">Nama</th>
              <th class="px-4 py-3">Versi</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Aksi</th>
            </tr>
          </thead>
          <tbody id="behavior-pack-table" class="divide-y divide-[#E5E6EF] bg-[#FBFBFD]"></tbody>
        </table>
      </div>
    </article>
  </section>

  <script>
    import { escapeHtml } from "../../lib/client";
    const feedback = document.getElementById("feedback");
    let busy = false;
    function setBusy(value: boolean) {
      busy = value;
      document.querySelectorAll<HTMLButtonElement>("#pack-upload-form button, [data-action]").forEach((button) => (button.disabled = value));
    }
    const resourcePackTable = document.getElementById("resource-pack-table");
    const behaviorPackTable = document.getElementById("behavior-pack-table");

    type FeedbackType = "info" | "success" | "error";
    type PackType = "resource" | "behavior";
    type PackItem = {
      id: string;
      name: string;
      version: string;
      type: PackType;
      folder: string;
      enabled: boolean;
    };

    function showFeedback(message: string, type: FeedbackType = "info") {
      if (!feedback) return;
      feedback.className = "feedback";
      feedback.dataset.type = type;
      feedback.textContent = message;
    }

    async function api<T>(url: string, options: RequestInit = {}): Promise<T> {
      const response = await fetch(url, options);
      const data = (await response.json()) as { message?: string } & T;
      if (!response.ok) {
        throw new Error(data.message || "Request gagal");
      }
      return data;
    }

    async function togglePack(type: PackType, pack: PackItem, enabled: boolean) {
      await api<{ ok: boolean }>("/api/packs/toggle", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({
          type,
          packId: pack.id,
          version: pack.version,
          enabled,
        }),
      });
    }

    async function deletePack(type: PackType, pack: PackItem) {
      await api<{ ok: boolean }>("/api/packs/delete", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ type, packId: pack.id }),
      });
    }

    function renderRows(target: HTMLElement, packs: PackItem[], type: PackType) {
      target.innerHTML = "";

      if (!packs.length) {
        target.innerHTML =
          '<tr><td colspan="4" class="px-4 py-4 text-center text-[#787A8B]">Belum ada addon. Impor .mcpack atau .mcaddon untuk menambahkan konten ke world ini.</td></tr>';
        return;
      }

      for (const pack of packs) {
        const row = document.createElement("tr");
        row.className = "text-[#45445A]";

        const statusText = pack.enabled ? "Aktif" : "Nonaktif";
        const toggleText = pack.enabled ? "Nonaktifkan" : "Aktifkan";
        const toggleClass = pack.enabled
          ? "rounded-lg border border-[#D5D3E2] bg-[#E5E6EF] px-3 py-1 text-xs font-semibold text-[#45445A] transition hover:bg-[#D5D3E2]"
          : "rounded-lg bg-[#7154C7] px-3 py-1 text-xs font-semibold text-white transition hover:bg-[#6043B5]";

        row.innerHTML = `
          <td class="px-4 py-3">${escapeHtml(pack.name)}</td>
          <td class="px-4 py-3">${escapeHtml(pack.version)}</td>
          <td class="px-4 py-3">${statusText}</td>
          <td class="px-4 py-3">
            <div class="flex flex-wrap gap-2">
              <button data-action="toggle" class="${toggleClass}">${toggleText}</button>
              <button data-action="delete" class="rounded-lg border border-[#D5D3E2] bg-[#E5E6EF] px-3 py-1 text-xs font-semibold text-[#45445A] transition hover:bg-[#D5D3E2]">Hapus</button>
            </div>
          </td>
        `;

        row.querySelector('[data-action="toggle"]')?.addEventListener("click", async () => {
          if (busy) return;
          setBusy(true);
          try {
            showFeedback("Mengubah status addon...");
            await togglePack(type, pack, !pack.enabled);
            await loadPacks();
            showFeedback("Status addon disimpan. Nyalakan server untuk menerapkannya.", "success");
          } catch (error) {
            showFeedback(error instanceof Error ? error.message : "Request gagal", "error");
          } finally {
            setBusy(false);
          }
        });

        row.querySelector('[data-action="delete"]')?.addEventListener("click", async () => {
          if (busy) return;
          if (!window.confirm(`Hapus addon ${pack.name}?`)) {
            return;
          }
          setBusy(true);
          try {
            showFeedback("Menghapus addon...");
            await deletePack(type, pack);
            await loadPacks();
            showFeedback("Addon berhasil dihapus.", "success");
          } catch (error) {
            showFeedback(error instanceof Error ? error.message : "Request gagal", "error");
          } finally {
            setBusy(false);
          }
        });

        target.appendChild(row);
      }
    }

    async function loadPacks() {
      const data = await api<{ resource: PackItem[]; behavior: PackItem[] }>("/api/packs");
      if (resourcePackTable instanceof HTMLElement) {
        renderRows(resourcePackTable, data.resource, "resource");
      }
      if (behaviorPackTable instanceof HTMLElement) {
        renderRows(behaviorPackTable, data.behavior, "behavior");
      }
    }

    document.getElementById("pack-upload-form")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = document.getElementById("pack-file");
      if (!(input instanceof HTMLInputElement) || !input.files || !input.files[0]) {
        showFeedback("Pilih file .mcpack atau .mcaddon terlebih dahulu.", "error");
        return;
      }

      if (busy) return;
      setBusy(true);
      const form = new FormData();
      form.append("file", input.files[0]);

      try {
        showFeedback("Mengimpor addon…");
        await api<{ ok: boolean }>("/api/packs", {
          method: "POST",
          body: form,
        });
        input.value = "";
        await loadPacks();
        showFeedback("Addon diimpor. Aktifkan pack yang dibutuhkan untuk world ini.", "success");
      } catch (error) {
        showFeedback(error instanceof Error ? error.message : "Request gagal", "error");
      } finally {
        setBusy(false);
      }
    });

    fetch("/api/settings")
      .then((response) => response.json())
      .then((data) => {
        const target = document.getElementById("pack-world");
        if (target) target.textContent = data.settings?.["level-name"] ?? "tidak tersedia";
      })
      .catch(() => {
        const target = document.getElementById("pack-world");
        if (target) target.textContent = "tidak tersedia";
      });

    loadPacks().catch((error) => {
      showFeedback(error instanceof Error ? error.message : "Request gagal", "error");
    });
  </script>
</DashboardShell>

---
import DashboardShell from "../../components/DashboardShell.astro";
import Icon from "../../components/Icon.astro";
---

<DashboardShell title="World | Bedrock Dashboard" activePath="/dashboard/worlds">
  <div id="feedback" class="hidden" role="status" aria-live="polite"></div>
  <div class="section-action">
    <p>Setiap world menyimpan petualangan dan addon-nya sendiri.</p><a href="/dashboard/setup" class="btn btn-primary"><Icon name="plus" size={15} />World baru</a>
  </div>
  <div class="notice">
    Hentikan server sebelum mengganti, menghapus, atau mengunduh world. Nyalakan kembali untuk memainkan world yang dipilih. Unduhan .mcworld adalah cadangan manual.
  </div>
  <article class="panel mb-5">
    <div class="panel-heading"><h2>Impor world milikmu</h2><span class="muted text-xs">.mcworld</span></div><form
      id="world-upload-form"
      class="flex flex-col gap-3 sm:flex-row sm:items-center"
    >
      <label class="sr-only" for="world-file">Pilih file world</label><input
        id="world-file"
        type="file"
        accept=".mcworld"
        required
        class="w-full min-w-0 rounded-lg border border-[#E5E6EF] bg-[#FBFBFD] p-3 text-xs file:mr-3 file:rounded file:border-0 file:bg-[#EEE8F8] file:px-3 file:py-2 file:text-[#7154C7]"
      /><button type="submit" class="btn">Impor world</button>
    </form>
  </article>
  <article class="panel">
    <div class="panel-heading"><h2>Koleksi world</h2><span id="world-count" class="muted text-xs">Memuat…</span></div><div id="world-list" class="world-list">
      <p class="empty-state">Memuat world tersimpan…</p>
    </div>
  </article>
  <script>
    import { api, escapeHtml, feedback } from "../../lib/client";
    type World = { name: string; active: boolean };
    const list = document.getElementById("world-list");
    let busy = false;
    function render(worlds: World[]) {
      const count = document.getElementById("world-count");
      if (count) count.textContent = `${worlds.length} world`;
      if (!list) return;
      list.innerHTML = worlds.length ? "" : '<p class="empty-state">Belum ada world. Pilih World baru atau impor file .mcworld untuk memulai.</p>';
      worlds.forEach((world) => {
        const row = document.createElement("div");
        row.className = "world-item";
        row.innerHTML = `<span class="world-thumbnail" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 30 30"><path fill="#85a66c" d="m15 2 13 7-13 7L2 9z"/><path fill="#b09478" d="M2 9v12l13 7V16z"/><path fill="#8b725d" d="M15 16v12l13-7V9z"/></svg></span><div class="world-info"><strong>${escapeHtml(world.name)}</strong><small>${world.active ? "World yang dipilih untuk server" : "World tersimpan"}</small></div>${world.active ? '<span class="world-active">Dipilih</span>' : ""}<div class="world-actions"><button data-action="export" class="btn btn-small">Unduh .mcworld</button><button data-action="activate" class="btn btn-small" ${world.active ? "disabled" : ""}>${world.active ? "World aktif" : "Aktifkan"}</button><button data-action="delete" class="btn btn-small" ${world.active ? "disabled" : ""}>Hapus</button></div>`;
        row.querySelectorAll<HTMLButtonElement>("button").forEach((button) =>
          button.addEventListener("click", async () => {
            if (busy) return;
            const action = button.dataset.action;
            if (action === "delete" && !confirm(`Hapus world “${world.name}” secara permanen? Unduh cadangan terlebih dahulu.`)) return;
            busy = true;
            button.disabled = true;
            try {
              if (action === "export") {
                feedback("Menyiapkan unduhan world…");
                const response = await fetch(`/api/worlds/export?name=${encodeURIComponent(world.name)}`);
                if (!response.ok) {
                  const data = await response.json();
                  throw new Error(data.message || "Unduhan gagal.");
                }
                const blob = await response.blob(),
                  url = URL.createObjectURL(blob),
                  link = document.createElement("a");
                link.href = url;
                link.download = `${world.name}.mcworld`;
                link.click();
                setTimeout(() => URL.revokeObjectURL(url), 30000);
                feedback("World berhasil diunduh. Simpan cadangan di tempat yang aman.", "success");
              } else {
                const result = await api<{ worlds: World[] }>("/api/worlds", {
                  method: action === "delete" ? "DELETE" : "POST",
                  headers: { "content-type": "application/json" },
                  body: JSON.stringify({ worldName: world.name }),
                });
                render(result.worlds);
                feedback(action === "delete" ? "World dihapus." : "World dipilih. Nyalakan server untuk memainkannya.", "success");
              }
            } catch (error) {
              feedback(error instanceof Error ? error.message : "Aksi gagal.", "error");
            } finally {
              busy = false;
              if (action === "export" || !world.active) button.disabled = false;
            }
          })
        );
        list.appendChild(row);
      });
    }
    async function load() {
      const data = await api<{ worlds: World[] }>("/api/worlds");
      render(data.worlds);
    }
    document.querySelector<HTMLFormElement>("#world-upload-form")?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const input = document.querySelector<HTMLInputElement>("#world-file"),
        button = (event.currentTarget as HTMLFormElement).querySelector("button");
      if (!input?.files?.[0] || busy) return;
      busy = true;
      if (button) button.disabled = true;
      try {
        const form = new FormData();
        form.append("file", input.files[0]);
        feedback("Mengimpor world…");
        await api("/api/worlds", { method: "POST", body: form });
        input.value = "";
        await load();
        feedback("World diimpor. Hentikan server lalu aktifkan untuk bermain.", "success");
      } catch (error) {
        feedback(error instanceof Error ? error.message : "Impor gagal.", "error");
      } finally {
        busy = false;
        if (button) button.disabled = false;
      }
    });
    if (new URLSearchParams(window.location.search).has("created"))
      feedback("World disiapkan dan dipilih. Nyalakan server melalui Ringkasan atau Konsol untuk membuat dunianya.", "success");
    load().catch((error) => {
      if (list) list.textContent = "World gagal dimuat. Muat ulang halaman untuk mencoba kembali.";
      feedback(error.message, "error");
    });
  </script>
</DashboardShell>

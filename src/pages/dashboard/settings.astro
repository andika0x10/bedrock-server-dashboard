---
import DashboardShell from "../../components/DashboardShell.astro";
const groups = [
  {
    title: "Permainan",
    fields: [
      { key: "server-name", label: "Nama server", hint: "Nama yang terlihat di daftar server." },
      { key: "gamemode", label: "Mode permainan", options: ["survival", "creative", "adventure"] },
      { key: "difficulty", label: "Tingkat kesulitan", options: ["peaceful", "easy", "normal", "hard"] },
      { key: "max-players", label: "Kapasitas pemain", type: "number", min: 1, max: 1000, hint: "Sesuaikan dengan kemampuan host." },
      { key: "allow-cheats", label: "Izinkan cheat", options: ["false", "true"], hint: "Mengizinkan perintah cheat dalam permainan." },
      { key: "player-idle-timeout", label: "Batas pemain diam (menit)", type: "number", min: 0, max: 100000, hint: "0 untuk menonaktifkan batas waktu." },
    ],
  },
  {
    title: "Akses dan koneksi",
    fields: [
      { key: "online-mode", label: "Verifikasi akun Xbox", options: ["true", "false"], hint: "Aktifkan agar server memverifikasi identitas pemain." },
      { key: "allow-list", label: "Batasi ke daftar pemain", options: ["true", "false"], hint: 'Tambahkan pemain melalui konsol: allowlist add "Gamertag".' },
      { key: "default-player-permission-level", label: "Izin pemain baru", options: ["visitor", "member", "operator"] },
      { key: "enable-lan-visibility", label: "Tampilkan di jaringan lokal", options: ["true", "false"] },
      { key: "transport", label: "Protokol koneksi", options: ["nethernet", "raknet"], hint: "NetherNet menggunakan TCP untuk koneksi awal dan UDP untuk permainan." },
      { key: "server-port", label: "Port server", type: "number", min: 1, max: 65535, hint: "NetherNet: TCP. RakNet: UDP IPv4. Default 19132." },
      { key: "server-portv6", label: "Port IPv6 RakNet (UDP)", type: "number", min: 1, max: 65535, hint: "Diabaikan oleh NetherNet; IPv4 dan IPv6 memakai port server yang sama." },
      { key: "server-ip", label: "IP lokal NetherNet", optional: true, hint: "Kosong untuk semua interface. Isi IP lokal host, bukan IP publik NAT." },
      {
        key: "server-udp-ports",
        label: "Port UDP NetherNet",
        optional: true,
        hint: "Contoh: 19140-19159. Di belakang NAT: IP-PUBLIK:19140-19159:19140-19159. Buka rentang UDP ini di firewall/router. Kosong memakai port dinamis.",
      },
    ],
  },
  {
    title: "Performa dan resource pack",
    fields: [
      { key: "view-distance", label: "Jarak pandang (chunk)", type: "number", min: 5, max: 128, hint: "Jarak lebih tinggi membutuhkan lebih banyak memori." },
      { key: "tick-distance", label: "Jarak simulasi (chunk)", type: "number", min: 4, max: 12 },
      { key: "max-threads", label: "Jumlah thread maksimum", type: "number", min: 0, max: 1024, hint: "0 mengikuti jumlah thread host." },
      { key: "texturepack-required", label: "Wajibkan resource pack", options: ["false", "true"], hint: "Pemain harus menerima resource pack untuk masuk." },
    ],
  },
];
---

<DashboardShell title="Pengaturan | Bedrock Dashboard" activePath="/dashboard/settings">
  <div id="feedback" class="hidden" role="status" aria-live="polite"></div>
  <div class="notice">
    Pengaturan disimpan untuk start berikutnya. Jika server sedang berjalan, restart melalui Konsol server agar perubahan diterapkan. Kelola world dan seed baru melalui halaman
    World.
  </div>
  <form id="settings-form" class="panel">
    {
      groups.map((group) => (
        <fieldset class="form-section">
          <>
            <legend>{group.title}</legend>
            <div class="form-grid">
              {group.fields.map((field) => (
                <label class="field">
                  {field.label}
                  {"options" in field ? (
                    <select name={field.key} disabled>
                      {field.options?.map((value) => (
                        <option value={value}>{value === "true" ? "Aktif" : value === "false" ? "Nonaktif" : value.charAt(0).toUpperCase() + value.slice(1)}</option>
                      ))}
                    </select>
                  ) : (
                    <input
                      name={field.key}
                      type={"type" in field ? (field.type === "number" ? "number" : "text") : "text"}
                      min={"min" in field ? field.min : undefined}
                      max={"max" in field ? field.max : undefined}
                      required={!("optional" in field && field.optional)}
                      disabled
                    />
                  )}
                  {"hint" in field && <small>{field.hint}</small>}
                </label>
              ))}
            </div>
          </>
        </fieldset>
      ))
    }
    <div class="form-actions">
      <p id="settings-state" role="status">Memuat pengaturan server…</p><button id="save-settings" type="submit" class="btn btn-primary" disabled>Simpan pengaturan</button>
    </div>
  </form>
  <script>
    import { api, feedback } from "../../lib/client";
    const form = document.querySelector<HTMLFormElement>("#settings-form"),
      button = document.querySelector<HTMLButtonElement>("#save-settings"),
      state = document.getElementById("settings-state");
    let dirty = false;
    form?.addEventListener("input", () => {
      dirty = true;
      if (state) state.textContent = "Ada perubahan yang belum disimpan.";
    });
    window.addEventListener("beforeunload", (event) => {
      if (dirty) {
        event.preventDefault();
      }
    });
    async function load() {
      const data = await api<{ settings: Record<string, string> }>("/api/settings");
      form?.querySelectorAll<HTMLInputElement | HTMLSelectElement>("input,select").forEach((input) => {
        input.value = data.settings[input.name] ?? "";
        input.disabled = false;
      });
      if (button) button.disabled = false;
      if (state) state.textContent = "Pengaturan server saat ini.";
    }
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!button || button.disabled) return;
      button.disabled = true;
      try {
        await api("/api/settings", { method: "PUT", headers: { "content-type": "application/json" }, body: JSON.stringify(Object.fromEntries(new FormData(form))) });
        dirty = false;
        feedback("Pengaturan disimpan. Restart server yang sedang berjalan untuk menerapkan perubahan.", "success");
        if (state) state.textContent = "Perubahan disimpan untuk start berikutnya.";
      } catch (error) {
        feedback(error instanceof Error ? error.message : "Pengaturan gagal disimpan.", "error");
      } finally {
        button.disabled = false;
      }
    });
    load().catch((error) => feedback(error.message, "error"));
  </script>
</DashboardShell>

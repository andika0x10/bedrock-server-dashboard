---
import DashboardShell from "../../components/DashboardShell.astro";
---

<DashboardShell title="Players | Bedrock Dashboard" activePath="/dashboard/players">
  <section class="space-y-6">
    <div id="feedback" role="status" aria-live="polite" class="hidden rounded-xl border border-[#E5E6EF] bg-[#FFFFFF] px-4 py-3 text-sm"></div>

    <article class="rounded-2xl border border-[#E5E6EF] bg-[#FFFFFF] p-5 sm:p-6">
      <div class="mb-4 flex items-center justify-between gap-3">
        <div>
          <h2 class="text-lg font-semibold text-[#242638]">Riwayat pemain</h2>
          <p class="mt-1 text-sm text-[#747788]">Urut dari durasi main terbanyak. Data berasal dari koneksi yang tercatat di konsol server.</p>
        </div>
        <button id="refresh-players" class="rounded-xl border border-[#D5D3E2] bg-[#E5E6EF] px-3 py-2 text-xs font-semibold text-[#45445A] transition hover:bg-[#D5D3E2] sm:text-sm"
          >Refresh</button
        >
      </div>

      <div class="overflow-x-auto rounded-xl border border-[#E5E6EF]">
        <table class="min-w-full divide-y divide-[#E5E6EF] text-left text-sm">
          <thead class="bg-[#F7F8FB] text-[#747788]">
            <tr>
              <th class="px-4 py-3">Player</th>
              <th class="px-4 py-3">Status</th>
              <th class="px-4 py-3">Durasi (Jam)</th>
              <th class="px-4 py-3">Durasi (Menit)</th>
              <th class="px-4 py-3">Terakhir terlihat</th>
            </tr>
          </thead>
          <tbody id="players-table-body" class="divide-y divide-[#E5E6EF] bg-[#FBFBFD] text-[#45445A]"></tbody>
        </table>
      </div>
    </article>
  </section>

  <script>
    import { escapeHtml } from "../../lib/client";
    const feedback = document.getElementById("feedback");
    const playersTableBody = document.getElementById("players-table-body");

    type FeedbackType = "info" | "success" | "error";
    type PlayerItem = {
      id: string;
      name: string;
      totalDurationMs: number;
      totalDurationMinutes: number;
      totalDurationHours: number;
      online: boolean;
      lastSeenMs: number | null;
    };

    function showFeedback(message: string, type: FeedbackType = "info") {
      if (!feedback) return;
      feedback.className = "feedback";
      feedback.dataset.type = type;
      feedback.textContent = message;
    }

    async function api<T>(url: string, options: RequestInit = {}): Promise<T> {
      const response = await fetch(url, options);
      const data = (await response.json()) as { message?: string } & T;
      if (!response.ok) {
        throw new Error(data.message || "Request gagal");
      }
      return data;
    }

    function formatDate(value: number | null) {
      if (!value) {
        return "-";
      }
      return new Date(value).toLocaleString("id-ID");
    }

    function renderPlayers(players: PlayerItem[]) {
      if (!(playersTableBody instanceof HTMLElement)) {
        return;
      }

      playersTableBody.innerHTML = "";
      if (!players.length) {
        playersTableBody.innerHTML =
          '<tr><td colspan="5" class="px-4 py-4 text-center text-[#787A8B]">Belum ada pemain tercatat. Ajak teman bergabung setelah server dinyalakan.</td></tr>';
        return;
      }

      for (const player of players) {
        const row = document.createElement("tr");
        row.className = "text-[#45445A]";

        row.innerHTML = `
          <td class="px-4 py-3">${escapeHtml(player.name)}</td>
          <td class="px-4 py-3">${player.online ? "Online" : "Offline"}</td>
          <td class="px-4 py-3">${player.totalDurationHours}</td>
          <td class="px-4 py-3">${player.totalDurationMinutes}</td>
          <td class="px-4 py-3">${formatDate(player.lastSeenMs)}</td>
        `;

        playersTableBody.appendChild(row);
      }
    }

    async function loadPlayers() {
      const data = await api<{ players: PlayerItem[] }>("/api/players");
      renderPlayers(data.players);
    }

    document.getElementById("refresh-players")?.addEventListener("click", async () => {
      try {
        showFeedback("Memuat data players...");
        await loadPlayers();
        showFeedback("Data players diperbarui.", "success");
      } catch (error) {
        showFeedback(error instanceof Error ? error.message : "Request gagal", "error");
      }
    });

    loadPlayers().catch((error) => {
      showFeedback(error instanceof Error ? error.message : "Request gagal", "error");
    });
  </script>
</DashboardShell>

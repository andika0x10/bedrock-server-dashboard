---
import DashboardShell from "../components/DashboardShell.astro";
import Icon from "../components/Icon.astro";
import WorldScene from "../components/WorldScene.astro";
---

<DashboardShell title="Ringkasan | Bedrock Dashboard" activePath="/dashboard">
  <div id="feedback" class="hidden" role="status" aria-live="polite"></div>
  <section class="overview-top" aria-label="Server dan koneksi">
    <article class="world-hero">
      <div class="world-hero-content">
        <span class="hero-tag"><Icon name="world" size={14} /> World aktif</span><h2 id="overview-world">Memuat duniamu…</h2><p id="overview-description">
          Menyiapkan informasi server dan petualangan berikutnya.
        </p><div class="hero-actions">
          <button id="overview-power" class="btn btn-primary" disabled><Icon name="play" size={14} /><span>Memeriksa…</span></button><a href="/dashboard/server" class="btn"
            ><Icon name="terminal" size={14} />Buka konsol</a>
        </div>
      </div>
      <WorldScene />
    </article>
    <article class="panel connection-panel">
      <h2>Ajak teman bermain</h2><p>Tambahkan server ini di Minecraft Bedrock.</p><div class="connection-address">
        <span id="connection-host">Memuat alamat…</span><button id="copy-address" class="copy-btn" aria-label="Salin alamat dan port server" disabled
          ><Icon name="copy" size={16} /></button>
      </div><div class="connection-details"><span>Port game (UDP)</span><strong id="connection-port">—</strong></div><div class="connection-tip">
        <Icon name="check" size={15} /><span>Gunakan IP atau domain host game. Alamat dashboard bisa berbeda; pastikan port UDP dapat diakses.</span>
      </div>
    </article>
  </section>
  <section class="stats-grid" aria-label="Pemantauan host dan pemain">
    {
      [
        { key: "cpu", label: "CPU host", icon: "cpu" },
        { key: "ram", label: "Memori host", icon: "memory" },
        { key: "disk", label: "Penyimpanan host", icon: "disk" },
        { key: "players", label: "Pemain online", icon: "players" },
      ].map((stat) => (
        <article class="stat">
          <>
            <div class="stat-label">
              {stat.label}
              <Icon name={stat.icon} size={17} />
            </div>
            <div class="stat-number" id={`stat-${stat.key}`}>
              —
            </div>
            <div class="stat-sub" id={`sub-${stat.key}`}>
              Memuat data…
            </div>
            <div class="meter">
              <span id={`meter-${stat.key}`} />
            </div>
          </>
        </article>
      ))
    }
  </section>
  <section class="overview-bottom">
    <article class="panel">
      <div class="panel-heading"><h2>Ruang petualanganmu</h2><a href="/dashboard/setup"><Icon name="plus" size={14} />World baru</a></div><div class="manage-row">
        <span class="row-icon"><Icon name="world" /></span><div><strong id="world-count">World tersimpan</strong><p>Ganti dunia atau unduh cadangan.</p></div><a
          href="/dashboard/worlds"
          class="btn btn-small">Kelola <Icon name="chevron" size={12} /></a>
      </div><div class="manage-row">
        <span class="row-icon purple"><Icon name="pack" /></span><div><strong id="pack-count">Addon terpasang</strong><p id="pack-enabled">Resource dan behavior pack.</p></div><a
          href="/dashboard/addons"
          class="btn btn-small">Kelola <Icon name="chevron" size={12} /></a>
      </div><div class="setup-prompt"><span>Sudah sesuai gaya bermainmu?</span><a href="/dashboard/settings">Atur server</a></div>
    </article>
    <article class="panel">
      <div class="panel-heading"><h2>Aktivitas server</h2><span class="live-label" id="activity-status">Diperbarui tiap 5 detik</span></div><pre
        id="overview-logs"
        class="activity-log"
        aria-label="Log server terbaru">Memuat aktivitas server…</pre>
    </article>
  </section>
  <script>
    import { api, bytes, feedback } from "../lib/client";
    type Overview = {
      settings: Record<string, string>;
      worlds: { name: string; active: boolean }[];
      packs: { resource: { enabled: boolean }[]; behavior: { enabled: boolean }[] };
      players: { online: boolean }[];
      status: { running: boolean; lastError: string | null };
      metrics: {
        cpuPercent: number;
        memory: { usedPercent: number; usedBytes: number; totalBytes: number };
        storage: { usedPercent: number; usedBytes: number; totalBytes: number };
      };
      logs: string[];
    };
    let running = false,
      busy = false,
      connection = "";
    const power = document.querySelector<HTMLButtonElement>("#overview-power");
    const set = (id: string, value: string) => {
      const el = document.getElementById(id);
      if (el) el.textContent = value;
    };
    function stat(key: string, value: string, sub: string, percent: number) {
      set(`stat-${key}`, value);
      set(`sub-${key}`, sub);
      const el = document.getElementById(`meter-${key}`);
      if (el) el.style.width = `${Math.min(100, Math.max(0, percent))}%`;
    }
    async function refresh() {
      try {
        const data = await api<Overview>("/api/overview");
        running = data.status.running;
        set("overview-world", data.settings["level-name"] || "World belum disiapkan");
        set("overview-description", `${data.settings["server-name"]} • ${data.settings.gamemode} • ${data.settings.difficulty}`);
        set("connection-host", window.location.hostname);
        set("connection-port", data.settings["server-port"]);
        connection = `${window.location.hostname}:${data.settings["server-port"]}`;
        const copy = document.querySelector<HTMLButtonElement>("#copy-address");
        if (copy) copy.disabled = false;
        if (power && !busy) {
          power.disabled = false;
          const label = power.querySelector("span");
          if (label) label.textContent = running ? "Hentikan server" : "Nyalakan server";
        }
        const m = data.metrics,
          percent = (n: number) => `${n.toFixed(1)}%`;
        stat("cpu", percent(m.cpuPercent), "Penggunaan seluruh host", m.cpuPercent);
        stat("ram", percent(m.memory.usedPercent), `${bytes(m.memory.usedBytes)} dari ${bytes(m.memory.totalBytes)}`, m.memory.usedPercent);
        stat("disk", percent(m.storage.usedPercent), `${bytes(m.storage.usedBytes)} dari ${bytes(m.storage.totalBytes)}`, m.storage.usedPercent);
        const online = running ? data.players.filter((p) => p.online).length : 0;
        stat("players", `${online} / ${data.settings["max-players"]}`, "Berdasarkan koneksi yang tercatat", (online / Number(data.settings["max-players"])) * 100);
        set("world-count", `${data.worlds.length} world tersimpan`);
        const packs = [...data.packs.resource, ...data.packs.behavior];
        set("pack-count", `${packs.length} addon terpasang`);
        set("pack-enabled", `${packs.filter((p) => p.enabled).length} aktif untuk world ini.`);
        set("overview-logs", data.logs.join("\n"));
        set("activity-status", "Diperbarui tiap 5 detik");
      } catch (error) {
        set("activity-status", "Gagal memperbarui data");
        feedback(error instanceof Error ? error.message : "Ringkasan gagal dimuat.", "error");
        if (power) power.disabled = true;
      }
    }
    power?.addEventListener("click", async () => {
      if (busy || (running && !confirm("Hentikan server? Pemain yang terhubung akan terputus."))) return;
      busy = true;
      power.disabled = true;
      const label = power.querySelector("span");
      if (label) label.textContent = "Memproses…";
      try {
        await api("/api/server/control", { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: running ? "stop" : "start" }) });
        feedback(running ? "Server dihentikan." : "Server dinyalakan.", "success");
      } catch (error) {
        feedback(error instanceof Error ? error.message : "Aksi gagal.", "error");
      } finally {
        busy = false;
        await refresh();
      }
    });
    document.getElementById("copy-address")?.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(connection);
        feedback("Alamat dan port disalin. Gunakan alamat host game jika berbeda.", "success");
      } catch {
        feedback(`Salin alamat secara manual: ${connection}`);
      }
    });
    refresh();
    setInterval(() => {
      if (!document.hidden && !busy) refresh();
    }, 5000);
  </script>
</DashboardShell>
